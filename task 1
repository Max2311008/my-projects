#include <iostream>
#include <Windows.h>
int main() {
	SetConsoleOutputCP(CP_UTF8);
	SetConsoleCP(CP_UTF8);
	// 2, 4, 5 строки обрабатывают кириллицу
	int km, m;//Создаём переменные
	std::cout << "Перевод км в м" << std::endl;
	std::cout << "км = ";
	//Выводим текст на экран
	std::cin >> km;//Вводим переменную с клавиатуры
	if (km < 0) {
		std::cout << "Ошибка, введите положительное число";
	} // Условие при котором не может быть отрицательных числе при таких величинах
	else {
		m = km * 1000;//Вычисляем количество м
		std::cout << "м = ";
		std::cout << m;//Выводим результат на экран
	}
	return 0;
}
