#include <iostream>
#include <Windows.h>
int main() {
	SetConsoleOutputCP(CP_UTF8);
	SetConsoleCP(CP_UTF8);
	// 2, 4, 5 строки обрабатывают кириллицу
	int t, v0 = 0; // Создание переменных с целыми числами
	double a, v, S; // Создание переменных с цифрами с точкой
	std::cout << "Введите ускорение: "; // Вывод текста на экран
	std::cin >> a; // Введение данных с клавиатуры
	std::cout << "Введите время: ";
	std::cin >> t;
	v = v0 + (a * t); // Применение формулы равноускоренного движения
	if (a < 0 || t < 0) {
		std::cout << "ОШИБКА, введите положительное число";
	}
	else {
		S = v * t; // Применение формулы равномерного движения
		std::cout << "Скорость - " << v << std::endl;
		std::cout << "Путь - " << S << std::endl;
		// Вывод текста на экран + сброс данных
	}
	return 0; // Вывод результа
}
